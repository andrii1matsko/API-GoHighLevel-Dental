generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id         String   @id @default(cuid())
  tokenId    String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId, revokedAt])
}

model CareUnit {
  id            String          @id
  emrId         String          @unique
  name          String
  address       Json
  instanceId    Int
  instanceName  String?
  phones        Json?
  emails        Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  healthService HealthService[]
  resources     Resource[]
}

model HealthService {
  id          String   @id
  emrId       String   @unique
  name        String
  description String?
  price       Float?
  duration    Int
  category    String?
  careUnitId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  careUnit    CareUnit @relation(fields: [careUnitId], references: [id], onDelete: Cascade)

  @@index([careUnitId])
}

model Resource {
  id             String   @id
  emrId          String   @unique
  externalId     String?
  externalIdType String?
  type           String
  emails         Json?
  name           String
  firstName      String?
  lastName       String?
  imageUrl       String?
  description    String?
  careUnitId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  careUnit       CareUnit @relation(fields: [careUnitId], references: [id], onDelete: Cascade)

  @@index([careUnitId])
}

model LeyrAppointment {
  id                  String   @id @default(cuid())
  leyrAppointmentId   String   @unique
  emr                 String
  emrId               String?
  careUnitId          String
  patientId           String
  resourceId          String
  healthcareServiceId String
  startAt             DateTime
  endAt               DateTime
  status              String?
  description         String?
  comment             String?
  participants        Json?
  healthcareServices  Json?
  rawPayload          Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  syncRecords AppointmentSync[]

  @@index([emr, careUnitId, startAt])
  @@index([patientId])
  @@index([resourceId])
}

model GhlAppointment {
  id                  String   @id @default(cuid())
  ghlAppointmentId    String   @unique
  locationId          String
  calendarId          String
  contactId           String
  assignedUserId      String?
  startAt             DateTime?
  endAt               DateTime?
  title               String?
  status              String?
  meetingLocationType String?
  address             String?
  isRecurring         Boolean?
  rrule               String?
  rawPayload          Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  syncRecords AppointmentSync[]

  @@index([locationId, calendarId, startAt])
  @@index([contactId])
  @@index([assignedUserId])
}

model AppointmentSync {
  id                String   @id @default(cuid())
  direction         String
  status            String
  sourceSystem      String
  sourceExternalId  String
  targetSystem      String
  targetExternalId  String?
  idempotencyKey    String?  @unique
  errorMessage      String?
  retryCount        Int      @default(0)
  syncedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  leyrAppointmentId String?
  ghlAppointmentId  String?

  leyrAppointment LeyrAppointment? @relation(fields: [leyrAppointmentId], references: [id], onDelete: SetNull)
  ghlAppointment  GhlAppointment?  @relation(fields: [ghlAppointmentId], references: [id], onDelete: SetNull)

  @@index([direction, status, createdAt])
  @@index([sourceSystem, sourceExternalId])
  @@index([targetSystem, targetExternalId])
}

model GhlOAuthToken {
  id                   String   @id @default(cuid())
  companyId            String
  locationId           String
  userType             String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  refreshToken         String
  tokenType            String?
  scope                String?
  refreshTokenId       String?
  userId               String?
  isBulkInstallation   Boolean?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([companyId, locationId, userType])
  @@index([companyId, userType])
  @@index([locationId, userType])
}

