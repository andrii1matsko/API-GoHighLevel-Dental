PORT=3000
# Docker Postgres: docker compose up -d postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opus_dental?schema=public
JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=3600

# Set to "true" to use mock Leyr/GHL services with fake data (no real API calls)
USE_MOCK_INTEGRATIONS=false

# Observability: set LOG_FORMAT=json for one JSON line per HTTP log / error log
# AUDIT_LOG_ENABLED=false disables persisting AuditLog rows (HTTP mutation audit trail)
LOG_FORMAT=
AUDIT_LOG_ENABLED=true

# CORS: comma-separated allowed origins (empty = disabled)
CORS_ORIGINS=

# Rate limiting: requests per window
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
THROTTLE_LONG_LIMIT=300

# Leyr API (Opus test integration)
LEYR_API_BASE_URL=https://api.leyr.io/api
LEYR_CLIENT_ID=your_id
LEYR_CLIENT_SECRET=your_client_secret
LEYR_ENCRYPTION_KEY=your_key
LEYR_EMR=opus
# Comma-separated EMR codes that do NOT support GET /patients (search).
# For these, we skip patient search and always call POST /patients (idempotent; the EHR dedupes).
LEYR_EMRS_WITHOUT_PATIENT_SEARCH=opus

# GoHighLevel API (destination calendar)
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_KEY=some-ghl-key
GHL_LOCATION_ID=some-location-id
GHL_CALENDAR_ID=some-calendar-id
GHL_CLIENT_ID=your-ghl-client-id
GHL_CLIENT_SECRET=your-ghl-client-secret
GHL_REDIRECT_URI=https://myapp.com/oauth/callback/test
GHL_OAUTH_USER_TYPE=Location
# Optional one-time bootstrap only; afterwards tokens are persisted in DB
GHL_AGENCY_REFRESH_TOKEN=
GHL_AGENCY_REFRESH_USER_TYPE=Company
GHL_COMPANY_ID=company-id-from-refresh-response
GHL_LOCATION_ID_OAUTH=location-id-from-refresh-response
GHL_TOKEN_REFRESH_LEEWAY_SECONDS=300

# Sync defaults (required for cross-system create)
SYNC_LEYR_DEFAULT_CARE_UNIT_ID=your-leyr-care-unit-id
SYNC_LEYR_DEFAULT_HEALTHCARE_SERVICE_ID=your-leyr-healthcare-service-id
SYNC_LEYR_DEFAULT_RESOURCE_ID=your-leyr-resource-id
SYNC_GHL_DEFAULT_CONTACT_ID=your-ghl-contact-id
SYNC_GHL_DEFAULT_LOCATION_ID=your-ghl-location-id
SYNC_GHL_DEFAULT_CALENDAR_ID=your-ghl-calendar-id
SYNC_IMMEDIATE_ON_WEBHOOK=true
# Before GHL→Leyr create, verify the slot is still free in Leyr/Muntra (default: true)
SYNC_PRECHECK_TIMESLOTS=true
# On permanent Leyr reject (slot taken, missing personnummer), cancel the GHL appointment (default: true)
SYNC_CANCEL_GHL_ON_LEYR_REJECT=true
# Leyr→GHL: only create GHL block slots for busy times (default: true). Set false for full appointment+contact sync.
SYNC_LEYR_TO_GHL_BLOCK_SLOTS_ONLY=true
# Push Leyr free timeslots into GHL Date-specific hours (native booking widget). Default off until validated in prod.
SYNC_GHL_AVAILABILITY_SYNC_ENABLED=false
# Horizon in days (capped at 31 — Leyr free-slots max). Defaults to LEYR_POLL_WINDOW_DAYS_FORWARD or 31.
SYNC_GHL_AVAILABILITY_HORIZON_DAYS=31
SYNC_GHL_AVAILABILITY_TIMEZONE=Europe/Stockholm
# Fallback only — sync prefers each GHL calendar's own slotDuration when available.
SYNC_GHL_AVAILABILITY_SLOT_DURATION_MINUTES=30
# Optional allow-lists (comma-separated). Empty = all mapped calendars/locations.
# Kållered (Muntra) + Majorstua (Opus):
SYNC_GHL_AVAILABILITY_LOCATION_IDS=YqUlz1ErFupeWjrXiiDJ,3hVPjaJpMLtF29L0zaBX
SYNC_GHL_AVAILABILITY_CALENDAR_IDS=M4fGB5ZSScHmQCMg7y1T,1Wji81CmUx0VmDAYSeAD,v13VJmzV87L2X0g48ycl,Lb3q4BnsHbyYy7zJBROl,BR5LpknCW9ENatACU9CO,D97Dz4eLRSnkaexG1JzR,3s30oeKlZN6hPd3MJp6E,NedrThKZq2oBK2LeY4Mp,oRBoMYo6YOdGTc23OVfK
# Optional Slack/Teams/generic webhook for loud fail alerts
# SYNC_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Leyr polling (replaces webhooks until Leyr supports them)
LEYR_POLL_INTERVAL_MINUTES=15
LEYR_POLL_WINDOW_DAYS_BACK=7
LEYR_POLL_WINDOW_DAYS_FORWARD=30
